# Copy this file to .env and fill in real values
# .env is git-ignored — NEVER commit real credentials

# Mastodon
MASTODON_TOKEN=your_mastodon_access_token_here
MASTODON_BASE_URL=https://mastodon.au

# Reddit (PRAW)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=comp90024_team_47/0.1

# Elasticsearch (in-cluster DNS)
ES_HOST=elasticsearch-es-http.elastic.svc.cluster.local
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=elastic
